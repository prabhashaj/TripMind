# ============================================================
# AI Travel Agent — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
POSTGRES_USER=travel_agent
POSTGRES_PASSWORD=travel_secret
POSTGRES_DB=travel_agent_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://travel_agent:travel_secret@postgres:5432/travel_agent_db

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- LLM (Mistral) ---
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL_LARGE=mistral-large-latest     # complex planning, itinerary, optimization
MISTRAL_MODEL_SMALL=mistral-small-latest     # intent extraction, classification, structured outputs

# --- Web Search (Tavily) ---
# Get your key at: https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# --- Maps (Mapbox) ---
# Get your key at: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here

# --- Weather (OpenWeatherMap) ---
# Get your key at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_key_here

# --- Flight Search (Amadeus) ---
# Optional — if not provided, mock data is used
# Get credentials at: https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=change_this_to_a_long_random_secret_key
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development
